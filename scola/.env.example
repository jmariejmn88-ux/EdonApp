# Connexion de l'application : rôle scola_app (jamais le propriétaire).
DATABASE_URL=postgresql://scola_app:MOT_DE_PASSE@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Connexion propriétaire : uniquement pour `npm run db:migrate`.
DATABASE_URL_OWNER=

# Better Auth : clé secrète (openssl rand -base64 32) et adresse du site.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
